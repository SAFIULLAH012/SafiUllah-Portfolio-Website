# ============================================================
# Flask Portfolio CMS - Environment Variables Template
# ============================================================
# Copy this file to .env and fill in real values.
# NEVER commit .env to version control.
# ============================================================

FLASK_APP=app.py
FLASK_ENV=development

# Generate a strong key: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-this-to-a-secure-random-key-before-deploying

# Database (SQLite for local dev; swap for PostgreSQL URI in production)
DATABASE_URL=sqlite:///portfolio.db

# Flask-Mail SMTP Configuration
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_USE_TLS=True
MAIL_USERNAME=your-email@gmail.com
MAIL_PASSWORD=your-gmail-app-password-here
MAIL_DEFAULT_SENDER=your-email@gmail.com

# Admin Contact Email (where contact form submissions are emailed to)
CONTACT_RECIPIENT_EMAIL=your-email@gmail.com

# Admin Registration Allow-List
# Comma-separated list of email addresses permitted to self-register as admin.
# Anyone whose email is NOT in this list will be denied registration.
ALLOWED_ADMIN_EMAILS=your-email@gmail.com
